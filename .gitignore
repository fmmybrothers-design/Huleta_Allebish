# Portfolio .gitignore

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
*.tmp
*.temp
.cache/

# Node modules (if you add npm packages later)
node_modules/

# Build outputs (if you add build process)
dist/
build/

# Backup files
*.bak
backup/
